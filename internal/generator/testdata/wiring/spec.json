{
  "paths": {
    "/v1/topups": {
      "post": {"requestBody": {"content": {"application/x-www-form-urlencoded": {"schema": {
        "properties": {"amount": {"type": "integer"}},
        "required": ["amount"],
        "type": "object"
      }}}}}
    },
    "/v1/topups/{topup}": {
      "get": {"responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/topup"}}}}}}
    },
    "/v1/topups/{topup}/cancel": {
      "post": {"requestBody": {"content": {"application/x-www-form-urlencoded": {"schema": {"properties": {}, "type": "object"}}}}}
    },
    "/v1/issuing/cards": {
      "post": {"requestBody": {"content": {"application/x-www-form-urlencoded": {"schema": {
        "properties": {
          "type": {"enum": ["physical", "virtual"], "type": "string"},
          "replacement_reason": {"enum": ["lost", "stolen"], "type": "string"},
          "status": {"enum": ["active", "inactive"], "type": "string"}
        },
        "type": "object"
      }}}}}
    },
    "/v1/issuing/cards/{card}": {
      "get": {"responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/issuing.card"}}}}}},
      "post": {"requestBody": {"content": {"application/x-www-form-urlencoded": {"schema": {
        "properties": {"status": {"enum": ["active", "inactive", "canceled"], "type": "string"}},
        "type": "object"
      }}}}}
    },
    "/v1/invoices": {
      "post": {"requestBody": {"content": {"application/x-www-form-urlencoded": {"schema": {
        "properties": {"description": {"type": "string"}},
        "type": "object"
      }}}}}
    },
    "/v1/invoices/{invoice}": {
      "get": {"responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/invoice"}}}}}}
    }
  },
  "components": {
    "schemas": {
      "topup": {"properties": {"id": {"type": "string"}, "amount": {"type": "integer"}}, "type": "object"},
      "issuing.card": {
        "properties": {
          "id": {"type": "string"},
          "number": {"type": "string"},
          "cvc": {"type": "string"},
          "replacement_reason": {"type": "string"},
          "type": {"enum": ["physical", "virtual"], "type": "string"},
          "status": {"enum": ["active", "inactive", "canceled"], "type": "string"}
        },
        "type": "object"
      },
      "invoice": {"properties": {"id": {"type": "string"}, "number": {"type": "string"}}, "type": "object"}
    }
  }
}
