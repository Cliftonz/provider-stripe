        "required": ["allowed_countries", "supported_currencies", "country", "currency", "email", "enabled", "expires_at", "return_url", "url", "kind", "labels", "lines", "marker", "product", "ratio", "settings", "size", "tags", "tax_rates", "title", "when"],
